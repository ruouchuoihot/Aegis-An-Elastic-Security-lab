  {
    "id": "aegis-aisoc-encoded-powershell",
    "name": "AiSOC: Encoded PowerShell execution",
    "enabled": true,
    "description": "Broadened from upstream encoded + execution-policy bypass to encoded execution alone, including supported short flags. Severity lowered to medium.",
    "severity": "medium",
    "risk_score": 50,
    "index": "logs-aegis.windows-*",
    "query_dsl": {
      "bool": {
        "filter": [
          {
            "bool": {
              "should": [
                {
                  "term": {
                    "winlog.provider_name": "Microsoft-Windows-Sysmon"
                  }
                },
                {
                  "term": {
                    "winlog.provider_name.keyword": "Microsoft-Windows-Sysmon"
                  }
                }
              ],
              "minimum_should_match": 1
            }
          },
          {
            "term": {
              "event.code": "1"
            }
          },
          {
            "term": {
              "process.name": "powershell.exe"
            }
          },
          {
            "bool": {
              "should": [
                {
                  "wildcard": {
                    "process.command_line": {
                      "value": "* -e *",
                      "case_insensitive": true
                    }
                  }
                },
                {
                  "wildcard": {
                    "process.command_line": {
                      "value": "* -en *",
                      "case_insensitive": true
                    }
                  }
                },
                {
                  "wildcard": {
                    "process.command_line": {
                      "value": "* -enc *",
                      "case_insensitive": true
                    }
                  }
                },
                {
                  "wildcard": {
                    "process.command_line": {
                      "value": "* -encodedcommand *",
                      "case_insensitive": true
                    }
                  }
                }
              ],
              "minimum_should_match": 1
            }
          }
        ]
      }
    },
    "mitre": {
      "tactic": "Execution",
      "technique_id": "T1059.001",
      "technique_name": "Encoded PowerShell execution"
    },
    "false_positives": [
      "Vendor management agents (allowlist by signed publisher)"
    ],
    "provenance": {
      "pack": "aisoc-windows-v1",
      "repository": "https://github.com/beenuar/AiSOC",
      "revision": "2a0d550165b9f82108a3fe1c487c44aa96ed1b24",
      "path": "detections/endpoint/powershell-encoded-command.yaml",
      "upstream_id": "det-endpoint-005",
      "upstream_name": "PowerShell with Encoded Command and Bypass Flag",
      "upstream_severity": "high",
      "license": "MIT",
      "adaptation": "Broadened from upstream encoded + execution-policy bypass to encoded execution alone, including supported short flags. Severity lowered to medium."
    }
  },
  {
    "id": "aegis-aisoc-registry-run-key",
    "name": "AiSOC: Registry Run key value set",
    "enabled": true,
    "description": "RegistryValueSet maps to Sysmon 13. Sysmon HKU\\SID roots normalize to HKCU; value name is removed before comparing the exact parent key.",
    "severity": "high",
    "risk_score": 70,
    "index": "logs-aegis.windows-*",
    "query_dsl": {
      "bool": {
        "filter": [
          {
            "bool": {
              "should": [
                {
                  "term": {
                    "winlog.provider_name": "Microsoft-Windows-Sysmon"
                  }
                },
                {
                  "term": {
                    "winlog.provider_name.keyword": "Microsoft-Windows-Sysmon"
                  }
                }
              ],
              "minimum_should_match": 1
            }
          },
          {
            "term": {
              "event.code": "13"
            }
          },
          {
            "terms": {
              "aegis.registry.key": [
                "hklm\\software\\microsoft\\windows\\currentversion\\run",
                "hkcu\\software\\microsoft\\windows\\currentversion\\run",
                "hklm\\software\\microsoft\\windows\\currentversion\\runonce"
              ]
            }
          }
        ]
      }
    },
    "mitre": {
      "tactic": "Persistence",
      "technique_id": "T1547.001",
      "technique_name": "Registry Run key value set"
    },
    "false_positives": [
      "Software installers (allowlist by signed publisher)"
    ],
    "provenance": {
      "pack": "aisoc-windows-v1",
      "repository": "https://github.com/beenuar/AiSOC",
      "revision": "2a0d550165b9f82108a3fe1c487c44aa96ed1b24",
      "path": "detections/endpoint/registry-runkey-write.yaml",
      "upstream_id": "det-endpoint-008",
      "upstream_name": "Persistence via Registry Run Key Write",
      "upstream_severity": "high",
      "license": "MIT",
      "adaptation": "RegistryValueSet maps to Sysmon 13. Sysmon HKU\\SID roots normalize to HKCU; value name is removed before comparing the exact parent key."
    }
  },
  {
    "id": "aegis-aisoc-task-suspicious-path",
    "name": "AiSOC: Scheduled task action in writable directory",
    "enabled": true,
    "description": "ScheduledTaskCreate maps to Security 4698; action Command is extracted from TaskContent XML. Task creation is distinct from action execution.",
    "severity": "high",
    "risk_score": 70,
    "index": "logs-aegis.windows-*",
    "query_dsl": {
      "bool": {
        "filter": [
          {
            "term": {
              "event.code": "4698"
            }
          },
          {
            "bool": {
              "should": [
                {
                  "term": {
                    "winlog.provider_name": "Microsoft-Windows-Security-Auditing"
                  }
                },
                {
                  "term": {
                    "winlog.provider_name.keyword": "Microsoft-Windows-Security-Auditing"
                  }
                }
              ],
              "minimum_should_match": 1
            }
          },
          {
            "bool": {
              "should": [
                {
                  "wildcard": {
                    "aegis.task.command_path": {
                      "value": "C:\\\\Users\\\\Public\\\\*",
                      "case_insensitive": true
                    }
                  }
                },
                {
                  "wildcard": {
                    "aegis.task.command_path": {
                      "value": "C:\\\\ProgramData\\\\*",
                      "case_insensitive": true
                    }
                  }
                },
                {
                  "wildcard": {
                    "aegis.task.command_path": {
                      "value": "C:\\\\Windows\\\\Temp\\\\*",
                      "case_insensitive": true
                    }
                  }
                }
              ],
              "minimum_should_match": 1
            }
          }
        ]
      }
    },
    "mitre": {
      "tactic": "Persistence",
      "technique_id": "T1053.005",
      "technique_name": "Scheduled task action in writable directory"
    },
    "false_positives": [
      "Software installers (allowlist by signed publisher)"
    ],
    "provenance": {
      "pack": "aisoc-windows-v1",
      "repository": "https://github.com/beenuar/AiSOC",
      "revision": "2a0d550165b9f82108a3fe1c487c44aa96ed1b24",
      "path": "detections/endpoint/scheduled-task-create-suspicious.yaml",
      "upstream_id": "det-endpoint-007",
      "upstream_name": "Scheduled Task Created Pointing to Suspicious Path",
      "upstream_severity": "high",
      "license": "MIT",
      "adaptation": "ScheduledTaskCreate maps to Security 4698; action Command is extracted from TaskContent XML. Task creation is distinct from action execution."
    }
  },
