# Project Aegis - Environment Configuration

# --- Stack Version ---
STACK_VERSION=8.12.0

# --- Cluster Settings ---
CLUSTER_NAME=aegis-cluster
LICENSE=basic

# --- Elasticsearch Settings ---
ES_PORT=9200
ES_MEM_LIMIT=2147483648
ELASTIC_PASSWORD=changeme

# --- Kibana Settings ---
KIBANA_PORT=5601
KIBANA_PUBLIC_URL=http://localhost:5601
KIBANA_MEM_LIMIT=1073741824
KIBANA_PASSWORD=changeme

# --- Fleet & Agent Settings ---
FLEET_PORT=8220
FLEET_ENROLLMENT_TOKEN=
# The enrollment token will be generated after the stack starts

# --- Advanced Analytics (Phase 5) ---
QDRANT_PORT=6333
SPARK_MASTER_PORT=8080
SPARK_WORKER_WEBUI_PORT=8081
# ----------------------------------

# --- Investigation Gateway (loopback only) ---
AEGIS_GATEWAY_PORT=8000
AEGIS_ALERT_INDEX=aegis-alerts-default
# Optional local-lab bearer token; set before sharing gateway access.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
AEGIS_GATEWAY_TOKEN=

# Native Elastic Security is the rule editor and detection engine.
# Generate the persistent key with: python scripts/setup_native_siem.py --prepare
AEGIS_KIBANA_ENCRYPTION_KEY=
# setup_native_siem.py sets this to 1 after successfully registering native rules.
AEGIS_NATIVE_SIEM=0

# Optional OpenAI-compatible LLM. Blank values keep the agent disabled.
# Ollama on the Docker host: http://host.docker.internal:11434/v1
AEGIS_LLM_BASE_URL=
AEGIS_LLM_MODEL=
AEGIS_LLM_API_KEY=

# --- Optional Windows Atomic Lab (compose.windows.yml) ---
# Password is generated into ignored lab/runtime/windows.env by prepare_windows_lab.py.
WINDOWS_VERSION=2022
WINDOWS_EDITION=core
WINDOWS_RAM=2G
WINDOWS_CPUS=2
WINDOWS_DISK=32G
WINDOWS_WEB_PORT=18006
WINDOWS_RDP_PORT=13389

# --- Networking ---
# Host IP for Fleet/Agent communication (optional, can be auto-detected)
# HOST_IP=127.0.0.1
